flowchart TB
    H[Human Controller / Mission Owner]
    COORD[Coordinator Agent]
    A1[Research Agent]
    A2[Planning Agent]
    A3[Execution Agent]
    ATF[Shared Agent Trust Fabric\nAssess identity, goal, context, risk, behavior, delegation]
    DG[Delegation Provenance\nLineage, scope, TTL, constraints]
    PDP[Ring 2 PDP / PEP\nDelegation-aware enforcement]
    TOOLS[Tools / Data / APIs / External Actions]
    VAL[Ring 3 Validation\nGoal drift, delegation anomalies, UEBA]
    GOV[Governance, Telemetry and Assurance\nAdaptive trust policies]
    RESP[Runtime Response\nConstrain, suspend delegation, contain, recover]
    OUT[Secure Outcomes]

    H --> COORD
    COORD --> A1
    COORD --> A2
    A2 --> A3
    COORD --> ATF
    A1 --> ATF
    A2 --> ATF
    A3 --> ATF
    ATF --> DG
    DG --> PDP
    ATF --> PDP
    PDP --> TOOLS
    TOOLS --> VAL
    DG --> VAL
    VAL --> GOV
    GOV --> PDP
    PDP --> RESP
    RESP --> OUT
    GOV --> OUT
